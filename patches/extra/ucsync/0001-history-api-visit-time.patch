--- a/chrome/browser/extensions/api/history/history_apitest.cc
+++ b/chrome/browser/extensions/api/history/history_apitest.cc
@@ -347,6 +347,52 @@ IN_PROC_BROWSER_TEST_F(HistoryApiTest, SearchAfterAdd) {
   ASSERT_TRUE(RunExtensionTest("history/regular/search_after_add")) << message_;
 }
 
+// UC-Sync: `addUrl` with `visitTime` records the visit at that time, which is
+// what importing a synchronized history needs (upstream stamps "now").
+IN_PROC_BROWSER_TEST_F(HistoryApiTest, AddUrl_WithVisitTime) {
+  static constexpr char kManifest[] =
+      R"({
+        "name": "chrome.history",
+        "version": "0.1",
+        "manifest_version": 3,
+        "permissions": ["history"],
+        "background": {
+          "service_worker": "add_url_visit_time.js"
+        }
+      })";
+  static constexpr char kBackgroundJs[] =
+      R"(chrome.test.runTests([
+        function addVisitInThePast() {
+          const visitTime = Date.now() - 7 * 24 * 60 * 60 * 1000;
+          const url = 'https://example.com/past-visit';
+          chrome.history.addUrl({url, visitTime}, function() {
+            chrome.test.assertNoError();
+            chrome.history.getVisits({url}, function(visits) {
+              chrome.test.assertEq(1, visits.length);
+              chrome.test.assertEq(visitTime, visits[0].visitTime);
+              chrome.test.succeed();
+            });
+          });
+        },
+        function rejectVisitTimeInTheFuture() {
+          const url = 'https://example.com/future-visit';
+          chrome.history.addUrl({url, visitTime: Date.now() + 60000}, function() {
+            chrome.test.assertLastError(
+                'visitTime must be a valid time that is not in the future.');
+            chrome.history.getVisits({url}, function(visits) {
+              chrome.test.assertEq(0, visits.length);
+              chrome.test.succeed();
+            });
+          });
+        },
+      ]);)";
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(kManifest);
+  test_dir.WriteFile(FILE_PATH_LITERAL("add_url_visit_time.js"), kBackgroundJs);
+
+  ASSERT_TRUE(RunExtensionTest(test_dir.UnpackedPath(), {}, {})) << message_;
+}
+
