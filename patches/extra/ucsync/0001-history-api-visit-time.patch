@@ -347,6 +347,20 @@ void HistorySearchFunction::SearchComplete(history::QueryResults results) {
   Release();  // Balanced in Run().
 }
 
+// UC-Sync: `addUrl` can record a visit that happened in the past. Upstream only
+// ever passes `base::Time::Now()` below, but `HistoryService::AddPage()` accepts
+// any time, so the API restriction is the only thing keeping a synchronized
+// visit from keeping its real timestamp in `chrome://history`.
+bool ParseVisitTime(double ms_from_epoch, base::Time* visit_time, std::string* error) {
+  base::Time time = base::Time::FromMillisecondsSinceUnixEpoch(ms_from_epoch);
+  if (time.is_null() || time > base::Time::Now()) {
+    *error = "visitTime must be a valid time that is not in the future.";
+    return false;
+  }
+  *visit_time = time;
+  return true;
+}
