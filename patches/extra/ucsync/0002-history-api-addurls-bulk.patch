 }
 
+// UC-Sync: `addUrls` importa un lote de visitas con su timestamp en una sola
+// llamada, y no registra nada si alguna entrada es inválida.
+IN_PROC_BROWSER_TEST_F(HistoryApiTest, AddUrls_Bulk) {
+  static constexpr char kManifest[] =
+      R"({
+        "name": "chrome.history",
+        "version": "0.1",
+        "manifest_version": 3,
+        "permissions": ["history"],
+        "background": {
+          "service_worker": "add_urls_bulk.js"
+        }
+      })";
+  static constexpr char kBackgroundJs[] =
+      R"(chrome.test.runTests([
+        function addBatchWithOwnTimestamps() {
+          const week = 7 * 24 * 60 * 60 * 1000;
+          const now = Date.now();
+          const rows = [
+            {url: 'https://example.com/bulk-a', title: 'A', visitTime: now - 3 * week},
+            {url: 'https://example.com/bulk-b', title: 'B', visitTime: now - 2 * week},
+            {url: 'https://example.com/bulk-c', title: 'C'},
+          ];
+          chrome.history.addUrls({urls: rows}, function() {
+            chrome.test.assertNoError();
+            chrome.history.getVisits({url: rows[0].url}, function(visits) {
+              chrome.test.assertEq(1, visits.length);
+              chrome.test.assertEq(rows[0].visitTime, visits[0].visitTime);
+              chrome.history.getVisits({url: rows[1].url}, function(visits2) {
+                chrome.test.assertEq(1, visits2.length);
+                chrome.test.assertEq(rows[1].visitTime, visits2[0].visitTime);
+                chrome.history.getVisits({url: rows[2].url}, function(visits3) {
+                  chrome.test.assertEq(1, visits3.length);
+                  chrome.test.assertTrue(visits3[0].visitTime <= Date.now());
+                  chrome.test.succeed();
+                });
+              });
+            });
+          });
+        },
+        function badRowAbortsWholeBatch() {
+          const good = 'https://example.com/bulk-good';
+          chrome.history.addUrls({urls: [
+            {url: good, visitTime: Date.now() - 60000},
+            {url: 'https://example.com/bulk-bad', visitTime: Date.now() + 60000},
+          ]}, function() {
+            chrome.test.assertLastError(
+                'visitTime must be a valid time that is not in the future.');
+            chrome.history.getVisits({url: good}, function(visits) {
+              chrome.test.assertEq(0, visits.length);
+              chrome.test.succeed();
+            });
+          });
+        },
+      ]);)";
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(kManifest);
+  test_dir.WriteFile(FILE_PATH_LITERAL("add_urls_bulk.js"), kBackgroundJs);
+
+  ASSERT_TRUE(RunExtensionTest(test_dir.UnpackedPath(), {}, {})) << message_;
+}
