+// UC-Sync: importa un historial entero con sus timestamps en una sola llamada.
+// `HistoryService::AddPagesWithDetails()` escribe una visita por fila con su
+// `last_visit_time`, que es exactamente lo que necesita una importación.
+ExtensionFunction::ResponseAction HistoryAddUrlsFunction::Run() {
+  std::optional<AddUrls::Params> params = AddUrls::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  history::URLRows rows;
+  std::string error;
+  for (const auto& details : params->details.urls) {
+    GURL url;
+    if (!ValidateUrl(details.url, &url, &error)) {
+      return RespondNow(Error(std::move(error)));
+    }
+    base::Time visit_time = base::Time::Now();
+    if (details.visit_time &&
+        !ParseVisitTime(*details.visit_time, &visit_time, &error)) {
+      return RespondNow(Error(std::move(error)));
+    }
+    history::URLRow row(url);
+    if (details.title) {
+      row.set_title(base::UTF8ToUTF16(*details.title));
+    }
+    row.set_last_visit(visit_time);
+    rows.push_back(row);
+  }
+
+  history::HistoryService* hs = HistoryServiceFactory::GetForProfile(
+      GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  hs->AddPagesWithDetails(rows, history::SOURCE_EXTENSION);
+
+  return RespondNow(NoArguments());
+}
