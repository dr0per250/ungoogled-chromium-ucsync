diff --git a/chrome/browser/resources/ucsync/background.js b/chrome/browser/resources/ucsync/background.js
new file mode 100644
index 0000000..fad9351
--- /dev/null
+++ b/chrome/browser/resources/ucsync/background.js
@@ -0,0 +1,233 @@
+// Service worker (MV3): alarmas, eventos de marcadores y API para la UI.
+import { ApiError, normalizeServerUrl } from './src/api.js';
+import { readTree } from './src/bookmarks.js';
+import { detectCapabilities, exportHistory, loadLedger, summarizeHistory } from './src/history.js';
+import { exportSettings } from './src/settings.js';
+import { IdMap, loadState, resetSyncState, saveState } from './src/state.js';
+import {
+  activeRoots,
+  activeTargets,
+  connect,
+  deleteVault,
+  exportBackup,
+  historyAudit,
+  listBackups,
+  recoverHistory,
+  restoreBackup,
+  syncNow,
+  testConnection,
+} from './src/sync.js';
+import { countNodes } from './src/tree.js';
+
+const ALARM = 'ucsync-auto';
+const DEBOUNCE_MS = 3000;
+
+let debounceTimer = null;
+let running = null;
+
+const ok = (data) => ({ ok: true, data });
+const fail = (err) => ({ ok: false, error: { message: err?.message ?? 'Error', code: err?.code ?? 'unknown' } });
+
+async function scheduleAlarm() {
+  const { settings } = await loadState();
+  await chrome.alarms.clear(ALARM);
+  if (settings.enabled && settings.intervalMinutes > 0) {
+    chrome.alarms.create(ALARM, { periodInMinutes: settings.intervalMinutes, delayInMinutes: settings.intervalMinutes });
+  }
+}
+
+function runSync(reason = 'auto') {
+  if (running) return running;
+  running = syncNow({ reason }).finally(() => {
+    running = null;
+  });
+  return running;
+}
+
+function scheduleSync() {
+  clearTimeout(debounceTimer);
+  debounceTimer = setTimeout(() => {
+    loadState()
+      .then(({ settings }) => {
+        if (settings.enabled) runSync('cambio-local').catch(() => {});
+      })
+      .catch(() => {});
+  }, DEBOUNCE_MS);
+}
+
+async function treeSnapshot() {
+  const { settings } = await loadState();
+  const map = await IdMap.load();
+  const tree = await readTree(activeRoots(settings), map);
+  await map.save();
+  return tree;
+}
+
+const EMPTY_HISTORY_SUMMARY = { total: 0, synced: 0, synthetic: 0, truncated: false, dropped: 0, incomplete: false };
+
+/**
+ * Historial sincronizado con la fecha REAL de cada visita: las entradas bajadas de otro
+ * dispositivo llevan `s: 'added'` (la visita la creó UC-Sync «ahora») y `addedAt`, así que
+ * la interfaz puede mostrar la fecha auténtica en vez de la de la añadidura. `timed` son las
+ * entradas cuya hora real está también en `chrome://history` (`tm: 1`), y `capabilities` dice si
+ * este Chromium admite `visitTime`.
+ */
+async function historyView({ limit = 200 } = {}) {
+  const { settings, sync } = await loadState();
+  const capabilities = await detectCapabilities({ history: chrome.history });
+  if (settings.sync?.history !== true) {
+    return ok({ disabled: true, entries: [], summary: EMPTY_HISTORY_SUMMARY, capabilities, last: sync.lastHistory ?? null });
+  }
+  const ledger = await loadLedger();
+  try {
+    const hist = await exportHistory({ ...settings.history, ledger });
+    const times = hist.entries.map((entry) => entry.v).filter((v) => v > 0);
+    return ok({
+      entries: hist.entries.slice(0, limit).map((entry) => ({ ...entry, addedAt: ledger[entry.u]?.addedAt ?? 0 })),
+      summary: summarizeHistory(hist),
+      capabilities,
+      // Las entradas que tienen su hora real en el historial del navegador, no sólo en UC-Sync.
+      timed: hist.entries.filter((entry) => entry.tm === 1).length,
+      oldest: times.length ? Math.min(...times) : 0,
+      newest: times.length ? Math.max(...times) : 0,
+      last: sync.lastHistory ?? null,
+      limit,
+    });
+  } catch (err) {
+    return ok({
+      unavailable: err.code === 'history_unavailable',
+      message: err.message,
+      entries: [],
+      summary: EMPTY_HISTORY_SUMMARY,
+      capabilities,
+      timed: 0,
+      last: sync.lastHistory ?? null,
+    });
+  }
+}
+
+const handlers = {
+  async 'app:state'() {
+    const { settings, sync } = await loadState();
+    return ok({
+      settings,
+      sync: {
+        configured: Boolean(sync.token && sync.keys),
+        revision: sync.revision,
+        lastSyncAt: sync.lastSyncAt,
+        lastError: sync.lastError,
+        status: sync.status,
+        conflicts: sync.conflicts,
+        lastHistory: sync.lastHistory ?? null,
+      },
+    });
+  },
+
+  async 'app:test'({ serverUrl }) {
+    return ok(await testConnection(serverUrl));
+  },
+
+  async 'app:connect'({ serverUrl, password, mode }) {
+    const result = await connect({ serverUrl, password, mode });
+    if (result.connected) await scheduleAlarm();
+    return ok(result);
+  },
+
+  async 'app:sync'() {
+    const result = await runSync('manual');
+    return ok({
+      result: result.result,
+      revision: result.revision,
+      conflicts: result.conflicts,
+      stats: result.stats,
+      history: result.history,
+    });
+  },
+
+  async 'app:save'({ settings }) {
+    const state = await loadState();
+    const merged = {
+      ...state.settings,
+      ...settings,
+      roots: { ...state.settings.roots, ...(settings?.roots ?? {}) },
+      sync: { ...state.settings.sync, ...(settings?.sync ?? {}) },
+      history: { ...state.settings.history, ...(settings?.history ?? {}) },
+    };
+    if (merged.serverUrl) merged.serverUrl = normalizeServerUrl(merged.serverUrl);
+    await saveState({ settings: merged, sync: state.sync });
+    await scheduleAlarm();
+    return ok(merged);
+  },
+
+  async 'app:unlink'() {
+    await resetSyncState();
+    await scheduleAlarm();
+    return ok({ unlinked: true });
+  },
+
+  async 'app:deleteVault'() {
+    await deleteVault();
+    await resetSyncState();
+    await scheduleAlarm();
+    return ok({ deleted: true });
+  },
+
+  async 'app:backups'() {
+    return ok(await listBackups());
+  },
+
+  async 'app:restoreBackup'({ key }) {
+    return ok(await restoreBackup(key));
+  },
+
+  async 'app:counts'() {
+    return ok(countNodes(await treeSnapshot()));
+  },
+
+  async 'app:history'({ limit } = {}) {
+    return historyView({ limit });
+  },
+
+  async 'app:historyRecover'() {
+    return ok(await recoverHistory());
+  },
+
+  async 'app:historyAudit'() {
+    return ok(await historyAudit({ limit: 30 }));
+  },
+};
+
+chrome.runtime.onMessage.addListener((message, _sender, sendResponse) => {
+  const handler = handlers[message?.type];
+  if (!handler) return false;
+  handler(message)
+    .then(sendResponse)
+    .catch((err) => sendResponse(fail(err)));
+  return true;
+});
+
+chrome.alarms.onAlarm.addListener((alarm) => {
+  if (alarm.name === ALARM) runSync('alarma').catch(() => {});
+});
+
+chrome.runtime.onInstalled.addListener(() => {
+  scheduleAlarm().catch(() => {});
+});
+
+chrome.runtime.onStartup.addListener(() => {
+  scheduleAlarm().catch(() => {});
+  loadState()
+    .then(({ settings }) => {
+      if (settings.enabled && settings.autoOnStart !== false) runSync('inicio').catch(() => {});
+    })
+    .catch(() => {});
+});
+
+for (const event of ['onCreated', 'onRemoved', 'onChanged', 'onMoved', 'onChildrenReordered', 'onImportEnded']) {
+  if (chrome.bookmarks[event]) chrome.bookmarks[event].addListener(() => scheduleSync());
+}
+
+void ApiError;
+void activeTargets;
+void exportSettings;
+void exportBackup;
