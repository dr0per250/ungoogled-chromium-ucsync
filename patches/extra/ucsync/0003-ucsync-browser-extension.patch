+<!doctype html>
+<html lang="es">
+<head>
+  <meta charset="utf-8">
+  <title>UC-Sync</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<main>
+  <header class="brand">
+    <img src="logo.svg" alt="">
+    <div>
+      <h1>UC-Sync</h1>
+      <p>Marcadores, historial y permisos por sitio, cifrados y en tu servidor</p>
+    </div>
+  </header>
+
+  <section class="card">
+    <h2>Conectar</h2>
+    <p class="hint">La contraseña cifra los datos en este navegador. No se envía al servidor y no se puede recuperar.</p>
+    <label class="field"><span>Servidor</span>
+      <input id="server-url" type="url" placeholder="http://10.7.93.19:8443" autocomplete="off">
+    </label>
+    <p class="hint" id="transport-hint" hidden></p>
+    <label class="field"><span>Contraseña</span>
+      <input id="password" type="password" autocomplete="current-password">
+    </label>
+    <button id="connect" class="primary">Conectar</button>
+    <div id="choice" class="choice" hidden>
+      <p class="hint">Ese servidor ya tiene datos. ¿Qué hago con los de este navegador?</p>
+      <div class="row">
+        <button id="use-server">Usar los del servidor</button>
+        <button id="use-local">Subir los de este navegador</button>
+      </div>
+    </div>
+    <div id="connect-message" class="message"></div>
+  </section>
+
+  <section class="card" id="status-card" hidden>
+    <h2>Estado</h2>
+    <div class="row" style="justify-content:space-between">
+      <span id="chip" class="status">—</span>
+      <span id="revision" class="mono">rev. —</span>
+    </div>
+    <dl class="meta">
+      <dt>Última sincronización</dt><dd id="last">—</dd>
+      <dt>Marcadores</dt><dd id="count">—</dd>
+    </dl>
+    <div class="row" style="margin-top:12px">
+      <button id="sync-now" class="primary">Sincronizar ahora</button>
+    </div>
+    <div id="status-message" class="message"></div>
+  </section>
+
+  <section class="card" id="targets-card" hidden>
+    <h2>Qué sincronizar</h2>
+    <label class="check"><input type="checkbox" id="b-bookmarks"> Marcadores</label>
+    <label class="check"><input type="checkbox" id="b-history"> Historial</label>
+    <label class="check"><input type="checkbox" id="b-settings"> Permisos por sitio</label>
+    <div class="row" style="margin-top:10px">
+      <button id="save-targets">Guardar</button>
+    </div>
+    <div id="targets-message" class="message"></div>
+  </section>
+
+  <section class="card" id="history-card" hidden>
+    <h2>Historial sincronizado</h2>
+    <p class="hint">La fecha mostrada es la visita real. Con el Chromium parcheado la visita se crea con su hora real y queda en <code>chrome://history</code>; en un Chromium sin parchear <code>chrome.history.addUrl()</code> no admite fechas del pasado, así que las entradas bajadas se crean «ahora» pero conservan su fecha auténtica en UC-Sync (marcadas abajo).</p>
+    <p class="hint" id="history-cap" hidden></p>
+    <p class="hint">UC-Sync <strong>nunca borra</strong> historial: sólo añade. Si borraste el historial a mano, usa <em>Reaplicar lo de la bóveda</em> para volver a añadir las URLs (la bóveda y el registro local conservan las fechas reales).</p>
+    <dl class="meta">
+      <dt>URLs del rango (este navegador)</dt><dd id="history-local">—</dd>
+      <dt>URLs en la bóveda</dt><dd id="history-vault">—</dd>
+      <dt>Que faltan aquí</dt><dd id="history-missing">—</dd>
+      <dt>Hora real en el navegador</dt><dd id="history-timed">—</dd>
+      <dt>Fecha real conservada</dt><dd id="history-synthetic">—</dd>
+      <dt>Última aplicación</dt><dd id="history-last">—</dd>
+    </dl>
+    <div class="row" style="margin-top:10px">
+      <button id="history-refresh">Ver historial</button>
+      <button id="history-recover">Reaplicar lo de la bóveda</button>
+    </div>
+    <table class="backups">
+      <thead><tr><th>Fecha real</th><th>Url</th><th>Origen</th></tr></thead>
+      <tbody id="history-body"><tr><td colspan="3">—</td></tr></tbody>
+    </table>
+    <div id="history-message" class="message"></div>
+  </section>
+
+  <details id="advanced" hidden>
+    <summary>Avanzado</summary>
+    <section class="card">
+      <label class="field"><span>Sincronizar automáticamente</span>
+        <select id="interval">
+          <option value="0">Sólo manualmente</option>
+          <option value="5">Cada 5 minutos</option>
+          <option value="15">Cada 15 minutos</option>
+          <option value="30">Cada 30 minutos</option>
+          <option value="60">Cada hora</option>
+        </select>
+      </label>
+      <label class="field"><span>Si hay conflicto</span>
+        <select id="policy">
+          <option value="merge">Fusionar cambios</option>
+          <option value="remote">Gana el servidor</option>
+          <option value="local">Gana este navegador</option>
+        </select>
+      </label>
+      <div class="row">
+        <label class="field" style="margin:0;max-width:120px"><span>Días de historial</span>
+          <input id="history-days" type="number" min="1" max="3650" value="90">
+        </label>
+        <label class="field" style="margin:0;max-width:170px"><span>Máximo de entradas (0 = todas)</span>
+          <input id="history-max" type="number" min="0" max="50000" value="0">
+        </label>
+      </div>
+      <div class="row" style="margin-top:12px">
+        <button id="save-advanced">Guardar</button>
+        <button id="export">Exportar copia</button>
+      </div>
+      <div id="advanced-message" class="message"></div>
+    </section>
+
+    <section class="card">
+      <h2>Copias locales</h2>
+      <p class="hint">Se guardan antes de descargar o fusionar marcadores.</p>
+      <table class="backups">
+        <thead><tr><th>Fecha</th><th>Motivo</th><th>Elementos</th><th></th></tr></thead>
+        <tbody id="backups-body"><tr><td colspan="4">—</td></tr></tbody>
+      </table>
+    </section>
+
+    <section class="card">
+      <h2>Desconectar</h2>
+      <div class="row">
+        <button id="unlink" class="danger">Olvidar la contraseña en este navegador</button>
+        <button id="delete-vault" class="danger">Borrar todo del servidor</button>
+      </div>
+      <div id="danger-message" class="message"></div>
+    </section>
+  </details>
+
+  <p class="hint">
+    UC-Sync viene integrado en este Chromium: se abre como <code>chrome://ucsync</code> y su ID es
+    <code>lidfhdhmbifmhikiaklbiehnhnkhoghe</code>.
+  </p>
+</main>
+<script type="module" src="options.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/ucsync/options.js b/chrome/browser/resources/ucsync/options.js
new file mode 100644
index 0000000..35e18b5
--- /dev/null
+++ b/chrome/browser/resources/ucsync/options.js
@@ -0,0 +1,399 @@
+// Ajustes: conectar con el servidor, elegir qué sincronizar y ver el estado.
+import { isLocalHost } from './src/api.js';
+
+const $ = (id) => document.getElementById(id);
+
+async function send(type, payload = {}) {
+  const response = await chrome.runtime.sendMessage({ type, ...payload });
+  if (!response) throw new Error('El service worker no respondió');
+  if (!response.ok) throw new Error(response.error?.message ?? 'Error');
+  return response.data;
+}
+
+function message(el, text, kind = '') {
+  el.textContent = text;
+  el.className = `message ${kind}`;
+}
+
+const fmtDate = (ms) => (ms ? new Date(ms).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' }) : '—');
+
+// En el build embebido los permisos son estáticos (manifest), así que ya están concedidos:
+// aquí sólo se comprueba, nunca se pide nada al usuario.
+async function hasOrigin(serverUrl) {
+  if (!chrome.permissions) return true;
+  const url = new URL(serverUrl);
+  return chrome.permissions.contains({ origins: [`${url.protocol}//${url.host}/*`] });
+}
+
+async function hasOptionalApis(sync) {
+  const wanted = [];
+  if (sync.history) wanted.push('history');
+  if (sync.settings) wanted.push('contentSettings');
+  if (!wanted.length || !chrome.permissions) return true;
+  return chrome.permissions.contains({ permissions: wanted });
+}
+
+/** Aviso de transporte: HTTP no lleva TLS, así que sólo vale en la red local. */
+function updateTransportHint() {
+  const el = $('transport-hint');
+  el.hidden = true;
+  el.textContent = '';
+  el.className = 'hint';
+  let url;
+  try {
+    url = new URL($('server-url').value.trim());
+  } catch {
+    return;
+  }
+  if (url.protocol !== 'http:') return;
+  if (!isLocalHost(url.hostname)) {
+    el.hidden = false;
+    el.className = 'hint error';
+    el.textContent = 'HTTP sólo se permite en la red local. Para un servidor en Internet, usa HTTPS.';
+    return;
+  }
+  el.hidden = false;
+  el.className = 'hint warn';
+  el.textContent = 'Sin TLS: la bóveda sigue cifrada de extremo a extremo, pero el token de acceso viaja por tu red local.';
+}
+
+function chip(sync) {
+  const el = $('chip');
+  if (sync.status === 'syncing') {
+    el.className = 'status';
+    el.textContent = 'Sincronizando…';
+  } else if (sync.status === 'error') {
+    el.className = 'status error';
+    el.textContent = 'Error';
+  } else if (sync.conflicts > 0) {
+    el.className = 'status conflict';
+    el.textContent = `${sync.conflicts} conflicto(s)`;
+  } else if (sync.configured) {
+    el.className = 'status ok';
+    el.textContent = 'Al día';
+  } else {
+    el.className = 'status';
+    el.textContent = 'Sin configurar';
+  }
+}
+
+async function refresh() {
+  const { settings, sync } = await send('app:state');
+  $('server-url').value = settings.serverUrl ?? '';
+  updateTransportHint();
+  chip(sync);
+  $('revision').textContent = `rev. ${sync.revision || '—'}`;
+  $('last').textContent = fmtDate(sync.lastSyncAt);
+  message($('status-message'), sync.lastError ?? '', sync.lastError ? 'error' : '');
+
+  const configured = sync.configured;
+  $('status-card').hidden = !configured;
+  $('targets-card').hidden = !configured;
+  $('advanced').hidden = !configured;
+  $('history-card').hidden = true;
+  if (!configured) return;
+
+  $('b-bookmarks').checked = settings.sync.bookmarks !== false;
+  $('b-history').checked = settings.sync.history === true;
+  $('b-settings').checked = settings.sync.settings === true;
+  $('interval').value = String(settings.intervalMinutes ?? 15);
+  $('policy').value = settings.policy ?? 'merge';
+  $('history-days').value = String(settings.history?.days ?? 90);
+  $('history-max').value = String(settings.history?.max ?? 0);
+  $('history-last').textContent = describeHistoryRun(sync.lastHistory);
+
+  try {
+    const counts = await send('app:counts');
+    $('count').textContent = counts.urls === 1 ? '1 marcador' : `${counts.urls} marcadores`;
+  } catch {
+    $('count').textContent = '—';
+  }
+  if (settings.sync.history === true) await refreshHistory();
+  await refreshBackups();
+}
+
+/** Resumen de la última aplicación del historial (conteos explícitos, nada silencioso). */
+function describeHistoryRun(last) {
+  if (!last) return '—';
+  const parts = [`${last.added} añadidas`, `${last.existing} ya estaban`];
+  if (last.dated > 0) parts.push(`${last.dated} con su hora real en el navegador`);
+  if (last.mode === 'now' && (last.total ?? 0) > 0) parts.push('hora real sólo en UC-Sync');
+  if (last.bulk === true) parts.push('en lotes');
+  if (last.failed) parts.push(`${last.failed} sin poder añadirse`);
+  if (last.truncated) parts.push(`${last.dropped} fuera por el máximo`);
+  return parts.join(' · ');
+}
+
+const historyOrigin = (entry) => {
+  if (entry.s !== 'added') return 'visitado aquí';
+  if (entry.tm === 1) return 'de otro dispositivo (su hora real está en el historial del navegador)';
+  return `de otro dispositivo (añadida el ${fmtDate(entry.addedAt)}: su hora real sólo está en UC-Sync)`;
+};
+
+/** Aviso de capacidad: sin el Chromium parcheado la hora real no puede escribirse en el historial. */
+function renderCapability(capabilities) {
+  const el = $('history-cap');
+  if (capabilities?.visitTime === true) {
+    el.hidden = true;
+    el.className = 'hint';
+    el.textContent = '';
+    return;
+  }
+  el.hidden = false;
+  el.className = 'hint warn';
+  el.textContent = 'Este Chromium no admite `visitTime`: la hora real sólo se ve en UC-Sync; se recupera con el Chromium parcheado.';
+}
+
+/**
+ * Historial sincronizado con su fecha real: UC-Sync no puede crear visitas del pasado, así
+ * que la fecha auténtica vive en el registro local y es la que se muestra aquí.
+ */
+async function refreshHistory() {
+  const view = await send('app:history', { limit: 100 });
+  $('history-card').hidden = view.disabled === true;
+  if (view.disabled) return;
+  renderCapability(view.capabilities);
+  $('history-local').textContent = `${view.summary?.total ?? 0} en ${fmtDate(view.oldest ?? 0)} → ${fmtDate(view.newest ?? 0)}`;
+  $('history-synthetic').textContent = `${view.summary?.synthetic ?? 0} con fecha de otro dispositivo`;
+  $('history-timed').textContent = `${view.timed ?? 0} de ${view.summary?.total ?? 0} tienen su hora real en chrome://history`;
+
+  try {
+    const audit = await send('app:historyAudit');
+    $('history-vault').textContent = audit.vault
+      ? `${audit.vault.entries} (rev. ${audit.vault.revision}${audit.vault.truncated ? `, recortadas ${audit.vault.dropped}` : ''})`
+      : 'ninguna todavía';
+    $('history-missing').textContent = audit.vault ? `${audit.missing} URLs` : '—';
+    $('history-last').textContent = describeHistoryRun(audit.last ?? view.last);
+    if (audit.missing > 0) {
+      message($('history-message'), `Faltan ${audit.missing} URLs de la bóveda en este navegador: pulsa «Reaplicar lo de la bóveda».`, 'warn');
+    }
+  } catch (err) {
+    $('history-vault').textContent = '—';
+    $('history-missing').textContent = '—';
+    $('history-last').textContent = describeHistoryRun(view.last);
+    message($('history-message'), err.message, 'error');
+  }
+
+  const body = $('history-body');
+  body.textContent = '';
+  if (view.unavailable || view.message) {
+    message($('history-message'), view.message ?? 'Sin acceso al historial', 'error');
+  } else if (view.summary?.truncated) {
+    message($('history-message'), `El máximo deja ${view.summary.dropped} URLs del rango fuera. Pon 0 para sincronizar todas.`, 'warn');
+  } else if (view.summary?.incomplete) {
+    message($('history-message'), 'El rango no se pudo leer entero; reduce los días de historial.', 'warn');
+  }
+
+  if (!view.entries.length) {
+    const tr = document.createElement('tr');
+    const td = document.createElement('td');
+    td.colSpan = 3;
+    td.textContent = view.unavailable ? 'Sin permiso de historial.' : 'Todavía no hay entradas sincronizadas.';
+    tr.append(td);
+    body.append(tr);
+    return;
+  }
+  for (const entry of view.entries) {
+    const tr = document.createElement('tr');
+    const date = document.createElement('td');
+    date.textContent = fmtDate(entry.v);
+    const url = document.createElement('td');
+    url.textContent = entry.u;
+    url.title = entry.t || entry.u;
+    const origin = document.createElement('td');
+    origin.textContent = historyOrigin(entry);
+    tr.append(date, url, origin);
+    body.append(tr);
+  }
+}
+
+async function refreshBackups() {
+  const backups = await send('app:backups');
+  const body = $('backups-body');
+  body.textContent = '';
+  if (!backups.length) {
+    const tr = document.createElement('tr');
+    const td = document.createElement('td');
+    td.colSpan = 4;
+    td.textContent = 'Todavía no hay copias.';
+    tr.append(td);
+    body.append(tr);
+    return;
+  }
+  for (const backup of backups) {
+    const tr = document.createElement('tr');
+    const date = document.createElement('td');
+    date.textContent = fmtDate(backup.at);
+    const reason = document.createElement('td');
+    reason.textContent = { pull: 'Antes de descargar', merge: 'Antes de fusionar' }[backup.reason] ?? backup.reason;
+    const total = document.createElement('td');
+    total.textContent = String(backup.total);
+    const action = document.createElement('td');
+    const button = document.createElement('button');
+    button.textContent = 'Restaurar';
+    button.addEventListener('click', async () => {
+      if (!confirm('¿Restaurar esta copia sobre tus marcadores actuales?')) return;
+      try {
+        await send('app:restoreBackup', { key: backup.key });
+        message($('advanced-message'), 'Copia restaurada.', 'ok');
+        await refresh();
+      } catch (err) {
+        message($('advanced-message'), err.message, 'error');
+      }
+    });
+    action.append(button);
+    tr.append(date, reason, total, action);
+    body.append(tr);
+  }
+}
+
+$('server-url').addEventListener('input', updateTransportHint);
+
+$('connect').addEventListener('click', async () => {
+  const serverUrl = $('server-url').value.trim();
+  const password = $('password').value;
+  if (!serverUrl) return message($('connect-message'), 'Escribe la dirección del servidor.', 'error');
+  if (password.length < 8) return message($('connect-message'), 'La contraseña necesita al menos 8 caracteres.', 'error');
+
+  const button = $('connect');
+  button.disabled = true;
+  message($('connect-message'), 'Conectando…');
+  try {
+    if (!(await hasOrigin(serverUrl))) throw new Error('Este navegador no dio acceso a ese origen (revisa la política de extensiones).');
+    const result = await send('app:connect', { serverUrl, password });
+    if (result.needsChoice) {
+      $('choice').hidden = false;
+      message($('connect-message'), `El servidor ya tiene datos (rev. ${result.revision}). Elige qué conservar.`);
+      return;
+    }
+    $('password').value = '';
+    message($('connect-message'), 'Conectado.', 'ok');
+    await refresh();
+  } catch (err) {
+    message($('connect-message'), err.message, 'error');
+  } finally {
+    button.disabled = false;
+  }
+});
+
+for (const [id, mode, text] of [['use-server', 'pull', 'Adoptando los datos del servidor…'], ['use-local', 'push', 'Subiendo los de este navegador…']]) {
+  $(id).addEventListener('click', async () => {
+    const serverUrl = $('server-url').value.trim();
+    const password = $('password').value;
+    message($('connect-message'), text);
+    try {
+      await send('app:connect', { serverUrl, password, mode });
+      $('choice').hidden = true;
+      $('password').value = '';
+      message($('connect-message'), 'Conectado.', 'ok');
+      await refresh();
+    } catch (err) {
+      message($('connect-message'), err.message, 'error');
+    }
+  });
+}
+
+$('save-targets').addEventListener('click', async () => {
+  const sync = { bookmarks: true, history: $('b-history').checked, settings: $('b-settings').checked };
+  try {
+    if (!(await hasOptionalApis(sync))) throw new Error('Este navegador no dio `history`/`contentSettings` (revisa la política de extensiones).');
+    await send('app:save', { settings: { sync } });
+    message($('targets-message'), 'Guardado.', 'ok');
+    await refresh();
+  } catch (err) {
+    message($('targets-message'), err.message, 'error');
+  }
+});
+
+$('save-advanced').addEventListener('click', async () => {
+  try {
+    await send('app:save', {
+      settings: {
+        intervalMinutes: Number($('interval').value),
+        policy: $('policy').value,
+        history: {
+          days: Math.max(1, Number($('history-days').value) || 90),
+          max: Math.max(0, Number($('history-max').value) || 0),
+        },
+      },
+    });
+    message($('advanced-message'), 'Guardado.', 'ok');
+  } catch (err) {
+    message($('advanced-message'), err.message, 'error');
+  }
+});
+
+$('history-refresh').addEventListener('click', async () => {
+  try {
+    await refreshHistory();
+    message($('history-message'), 'Historial actualizado.', 'ok');
+  } catch (err) {
+    message($('history-message'), err.message, 'error');
+  }
+});
+
+$('history-recover').addEventListener('click', async () => {
+  if (!confirm('¿Volver a añadir al navegador las URLs guardadas en la bóveda que falten? No se borra nada.')) return;
+  const button = $('history-recover');
+  button.disabled = true;
+  message($('history-message'), 'Reaplicando el historial de la bóveda…');
+  try {
+    const res = await send('app:historyRecover');
+    message($('history-message'), `Reaplicado: ${res.added} añadidas, ${res.existing} ya estaban${res.failed ? `, ${res.failed} sin poder añadirse` : ''}.`, 'ok');
+    await refreshHistory();
+  } catch (err) {
+    message($('history-message'), err.message, 'error');
+  } finally {
+    button.disabled = false;
+  }
+});
+
+$('sync-now').addEventListener('click', async () => {
+  const button = $('sync-now');
+  button.disabled = true;
+  message($('status-message'), 'Sincronizando…');
+  try {
+    const result = await send('app:sync');
+    const extra = result.history ? ` · historial: ${describeHistoryRun(result.history)}` : '';
+    message($('status-message'), `${result.result} · rev. ${result.revision}${extra}`, 'ok');
+  } catch (err) {
+    message($('status-message'), err.message, 'error');
+  } finally {
+    button.disabled = false;
+    await refresh();
+  }
+});
+
+$('export').addEventListener('click', async () => {
+  const { settings } = await send('app:state');
+  const { sync } = await send('app:state');
+  if (!sync.configured) return message($('advanced-message'), 'Configura primero la sincronización.', 'error');
+  const tree = await send('app:counts');
+  const blob = new Blob([JSON.stringify({ format: 'ucsync-resumen', exportedAt: new Date().toISOString(), serverUrl: settings.serverUrl, marcadores: tree }, null, 2)], { type: 'application/json' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `ucsync-${new Date().toISOString().slice(0, 10)}.json`;
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 5000);
+});
+
+$('unlink').addEventListener('click', async () => {
+  if (!confirm('¿Olvidar la contraseña en este navegador? Tus marcadores no se tocan.')) return;
+  await send('app:unlink');
+  message($('danger-message'), 'Desconectado.', 'ok');
+  await refresh();
+});
+
+$('delete-vault').addEventListener('click', async () => {
+  if (!confirm('¿Borrar todo lo sincronizado en el servidor? No se puede deshacer.')) return;
+  try {
+    await send('app:deleteVault');
+    message($('danger-message'), 'Bóveda borrada del servidor.', 'ok');
+    await refresh();
+  } catch (err) {
+    message($('danger-message'), err.message, 'error');
+  }
+});
+
+refresh().catch((err) => message($('connect-message'), err.message, 'error'));
