+:root {
+  color-scheme: light dark;
+  --bg: #f6f7f9;
+  --panel: #ffffff;
+  --text: #16181d;
+  --muted: #5f6672;
+  --line: #e2e5ea;
+  --accent: #2563eb;
+  --accent-text: #ffffff;
+  --ok: #15803d;
+  --warn: #b45309;
+  --err: #b91c1c;
+  --radius: 10px;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #14161a;
+    --panel: #1c1f25;
+    --text: #e8eaee;
+    --muted: #9aa3b2;
+    --line: #2b3038;
+    --accent: #4f8cff;
+    --accent-text: #0b1220;
+    --ok: #4ade80;
+    --warn: #fbbf24;
+    --err: #f87171;
+  }
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+
+main {
+  max-width: 760px;
+  margin: 0 auto;
+  padding: 28px 20px 64px;
+}
+
+header.brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-bottom: 22px;
+}
+
+header.brand img { width: 32px; height: 32px; }
+header.brand h1 { font-size: 20px; margin: 0; }
+header.brand p { margin: 0; color: var(--muted); font-size: 13px; }
+
+section.card {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 18px 20px;
+  margin-bottom: 16px;
+}
+
+section.card h2 {
+  font-size: 15px;
+  margin: 0 0 4px;
+}
+
+section.card p.hint {
+  margin: 0 0 14px;
+  color: var(--muted);
+  font-size: 13px;
+}
+
+section.card p.hint.warn { color: var(--warn); }
+section.card p.hint.error { color: var(--err); }
+
+label.field { display: block; margin-bottom: 12px; }
+label.field span { display: block; font-size: 13px; color: var(--muted); margin-bottom: 4px; }
+
+input[type="text"], input[type="url"], input[type="password"], select {
+  width: 100%;
+  padding: 9px 11px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--bg);
+  color: var(--text);
+  font: inherit;
+}
+
+input:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
+.row > * { flex: 0 0 auto; }
+.grow { flex: 1 1 220px; }
+
+button {
+  font: inherit;
+  padding: 9px 14px;
+  border-radius: 8px;
+  border: 1px solid var(--line);
+  background: var(--panel);
+  color: var(--text);
+  cursor: pointer;
+}
+
+button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); font-weight: 600; }
+button.danger { border-color: var(--err); color: var(--err); }
+button:disabled { opacity: 0.55; cursor: not-allowed; }
+
+.check { display: flex; align-items: center; gap: 8px; margin: 6px 0; }
+.check input { width: 16px; height: 16px; }
+
+.status {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 13px;
+  padding: 3px 9px;
+  border-radius: 999px;
+  border: 1px solid var(--line);
+  color: var(--muted);
+}
+.status.ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); }
+.status.error { color: var(--err); border-color: color-mix(in srgb, var(--err) 40%, var(--line)); }
+.status.conflict { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, var(--line)); }
+
+dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; font-size: 13px; }
+dl.meta dt { color: var(--muted); }
+dl.meta dd { margin: 0; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+
+.message { margin-top: 12px; font-size: 13px; min-height: 18px; }
+.message.ok { color: var(--ok); }
+.message.error { color: var(--err); }
+.message.warn { color: var(--warn); }
+
+hr { border: 0; border-top: 1px solid var(--line); margin: 16px 0; }
+
+.tabs { display: flex; gap: 6px; margin-bottom: 14px; }
+.tabs button[aria-selected="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
+
+table.backups { width: 100%; border-collapse: collapse; font-size: 13px; }
+table.backups th, table.backups td { text-align: left; padding: 6px 4px; border-bottom: 1px solid var(--line); }
+table.backups tr:last-child td { border-bottom: 0; }
+
+code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; }
+
+/* popup */
+body.popup { width: 340px; }
+body.popup main { padding: 16px; }
+body.popup section.card { margin-bottom: 10px; padding: 14px; }
+
+.choice { border-top: 1px solid var(--line); margin-top: 14px; padding-top: 12px; }
+details > summary {
+  cursor: pointer;
+  color: var(--muted);
+  font-size: 13px;
+  margin: 6px 0 10px;
+  list-style: none;
+}
+details > summary::-webkit-details-marker { display: none; }
+details > summary::before { content: '▸ '; }
+details[open] > summary::before { content: '▾ '; }
