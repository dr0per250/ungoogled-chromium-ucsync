+++ b/chrome/browser/resources/ucsync/src/tree.js
@@ -0,0 +1,210 @@
+// Modelo de árbol y fusión a tres bandas (base, local, remoto).
+//
+// Cada nodo lleva un id estable (uuid) que el cliente mantiene asociado al
+// marcador nativo, de modo que renombrar o mover un marcador no lo convierte
+// en "borrado + añadido". La fusión es estructural y determinista: mismo
+// resultado en cualquier dispositivo, sin depender del orden de llegada.
+import { canonicalJson } from './util.js';
+
+export const ROOTS = ['bookmark_bar', 'other', 'mobile'];
+
+export const emptyTree = () => ({
+  v: 1,
+  roots: Object.fromEntries(ROOTS.map((key) => [key, { id: key, type: 'folder', title: key, children: [] }])),
+});
+
+export function countNodes(tree) {
+  let urls = 0;
+  let folders = 0;
+  const walk = (node) => {
+    if (node.type === 'url') urls += 1;
+    else {
+      folders += 1;
+      for (const child of node.children ?? []) walk(child);
+    }
+  };
+  for (const key of ROOTS) if (tree.roots[key]) walk(tree.roots[key]);
+  return { urls, folders, total: urls + folders };
+}
+
+/** Campos que definen el contenido de un nodo (sin hijos ni metadatos volátiles). */
+export function nodeSignature(node) {
+  return canonicalJson(node.type === 'url'
+    ? { t: 'url', title: node.title ?? '', url: node.url ?? '' }
+    : { t: 'folder', title: node.title ?? '' });
+}
+
+export function indexById(tree) {
+  const index = new Map();
+  const walk = (node) => {
+    index.set(node.id, node);
+    for (const child of node.children ?? []) walk(child);
+  };
+  for (const key of ROOTS) if (tree.roots[key]) walk(tree.roots[key]);
+  return index;
+}
+
+export function diffTrees(fromTree, toTree) {
+  const from = indexById(fromTree ?? emptyTree());
+  const to = indexById(toTree ?? emptyTree());
+  const added = [];
+  const removed = [];
+  const modified = [];
+  for (const [id, node] of to) {
+    const previous = from.get(id);
+    if (!previous) added.push(node);
+    else if (nodeSignature(previous) !== nodeSignature(node)) modified.push(node);
+  }
+  for (const [id, node] of from) if (!to.has(id)) removed.push(node);
+  return { added, removed, modified };
+}
+
+export function pruneRoots(tree, roots) {
+  const next = emptyTree();
+  for (const key of ROOTS) next.roots[key] = roots.includes(key) && tree.roots[key] ? tree.roots[key] : { id: key, type: 'folder', title: key, children: [] };
+  return next;
+}
+
+function mergeLists(baseChildren, localChildren, remoteChildren, ctx) {
+  const base = new Map((baseChildren ?? []).map((n) => [n.id, n]));
+  const local = new Map((localChildren ?? []).map((n) => [n.id, n]));
+  const remote = new Map((remoteChildren ?? []).map((n) => [n.id, n]));
+  const order = [];
+  const seen = new Set();
+  const push = (id) => {
+    if (!seen.has(id)) {
+      seen.add(id);
+      order.push(id);
+    }
+  };
+  for (const id of base.keys()) push(id);
+  for (const id of local.keys()) push(id);
+  for (const id of remote.keys()) push(id);
+
+  const result = [];
+  for (const id of order) {
+    const b = base.get(id);
+    const l = local.get(id);
+    const r = remote.get(id);
+
+    if (!b && l && r) {
+      // Añadido en ambos lados: si coinciden, uno; si no, decide la política.
+      if (nodeSignature(l) === nodeSignature(r)) result.push(ctx.mergeChildren(l, r, null));
+      else result.push(ctx.pick(l, r, null, ctx));
+      continue;
+    }
+    if (b && !l && !r) continue; // borrado en ambos
+    if (b && l && !r) {
+      // Borrado en remoto.
+      if (nodeSignature(b) === nodeSignature(l)) continue; // sin cambios locales → aceptar borrado
+      result.push(ctx.deletedElsewhere(b, l, ctx));
+      continue;
+    }
+    if (b && !l && r) {
+      // Borrado en local.
+      if (nodeSignature(b) === nodeSignature(r)) continue;
+      result.push(ctx.deletedLocally(b, r, ctx));
+      continue;
+    }
+    if (!b && l) {
+      result.push(ctx.onlyLocal(l));
+      continue;
+    }
+    if (!b && r) {
+      result.push(ctx.onlyRemote(r));
+      continue;
+    }
+    if (!b) continue;
+
+    // Presente en los tres: comparar cambios de campos y de hijos.
+    const localChanged = nodeSignature(l) !== nodeSignature(b);
+    const remoteChanged = nodeSignature(r) !== nodeSignature(b);
+    let chosen = l;
+    if (localChanged && remoteChanged && nodeSignature(l) !== nodeSignature(r)) {
+      chosen = ctx.pick(l, r, b, ctx);
+      ctx.conflicts.push({ id, base: b, local: l, remote: r });
+    } else if (remoteChanged) {
+      chosen = r;
+    } else {
+      chosen = l;
+    }
+
+    if (chosen.type === 'folder') {
+      result.push(ctx.mergeChildren(chosen, l, r, b));
+    } else {
+      result.push({ ...chosen });
+    }
+  }
+  return result;
+}
+
+/**
+ * Fusiona tres versiones del árbol.
+ *
+ * @param {object} args
+ * @param {object|null} args.base  último árbol sincronizado (null = sin base)
+ * @param {object} args.local
+ * @param {object} args.remote
+ * @param {'merge'|'ask'|'remote'|'local'} args.policy
+ * @returns {{tree: object, conflicts: Array, stats: object}}
+ */
+export function mergeTrees({ base, local, remote, policy = 'merge' }) {
+  const conflicts = [];
+  const baseTree = base ?? emptyTree();
+
+  const ctx = {
+    policy,
+    conflicts,
+    // En conflicto, `merge`/`ask` se resuelven con remoto para ser deterministas.
+    pick(l, r, b, self) {
+      if (self.policy === 'local') return { ...l };
+      if (self.policy === 'remote') return { ...r };
+      return { ...r };
+    },
+    onlyLocal: (l) => ({ ...l, children: l.children ? [...l.children] : undefined }),
+    onlyRemote: (r) => ({ ...r, children: r.children ? [...r.children] : undefined }),
+    deletedElsewhere(b, l, self) {
+      // Borrado en remoto pero modificado en local: local gana salvo política 'remote'.
+      if (self.policy === 'remote') return null;
+      self.conflicts.push({ id: b.id, kind: 'delete-remote', base: b, local: l });
+      return { ...l };
+    },
+    deletedLocally(b, r, self) {
+      if (self.policy === 'local') return null;
+      self.conflicts.push({ id: b.id, kind: 'delete-local', base: b, remote: r });
+      return { ...r };
+    },
+    mergeChildren(chosen, l, r, b) {
+      if (!chosen.children && !l.children && !r.children) return { ...chosen, children: [] };
+      const children = mergeLists(
+        b ? b.children : [],
+        (l ?? chosen).children ?? [],
+        (r ?? chosen).children ?? [],
+        ctx,
+      ).filter(Boolean);
+      return { ...chosen, children };
+    },
+  };
+
+  const tree = { v: 1, roots: {} };
+  for (const key of ROOTS) {
+    const b = baseTree.roots?.[key] ?? { id: key, type: 'folder', title: key, children: [] };
+    const l = local.roots?.[key] ?? { id: key, type: 'folder', title: key, children: [] };
+    const r = remote.roots?.[key] ?? { id: key, type: 'folder', title: key, children: [] };
+    tree.roots[key] = {
+      id: key,
+      type: 'folder',
+      title: key,
+      children: mergeLists(b.children, l.children, r.children, ctx).filter(Boolean),
+    };
+  }
+
+  return {
+    tree,
+    conflicts,
+    stats: {
+      conflicts: conflicts.length,
+      ...countNodes(tree),
+    },
+  };
+}
