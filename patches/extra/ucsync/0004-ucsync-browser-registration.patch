+// UC-Sync: `chrome://ucsync` es un atajo a la página de opciones de la extensión integrada.
+#ifndef CHROME_BROWSER_UI_WEBUI_UCSYNC_UCSYNC_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_UCSYNC_UCSYNC_UI_H_
+
+#include "content/public/browser/webui_config.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/common/url_constants.h"
+
+namespace ucsync {
+
+class UCSyncUI;
+
+// Config para chrome://ucsync.
+class UCSyncUIConfig : public content::DefaultWebUIConfig<UCSyncUI> {
+ public:
+  UCSyncUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, "ucsync") {}
+};
+
+// Redirige al `options.html` de la extensión embebida; no sirve contenido propio.
+class UCSyncUI : public content::WebUIController {
+ public:
+  explicit UCSyncUI(content::WebUI* web_ui);
+
+  UCSyncUI(const UCSyncUI&) = delete;
+  UCSyncUI& operator=(const UCSyncUI&) = delete;
+
+  // WebUIController:
+  void WebUIPrimaryPageChanged(content::Page& page) override;
+};
+
+}  // namespace ucsync
+
+#endif  // CHROME_BROWSER_UI_WEBUI_UCSYNC_UCSYNC_UI_H_
