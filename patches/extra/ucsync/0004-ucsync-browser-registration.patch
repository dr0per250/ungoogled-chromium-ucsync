+// `chrome://ucsync` y las claves que UC-Sync guarda en `chrome.storage`.
+inline constexpr std::string_view kExtensionId =
+    "lidfhdhmbifmhikiaklbiehnhnkhoghe";
+
+// Página de opciones de esa extensión (`options_ui.open_in_tab: true`).
