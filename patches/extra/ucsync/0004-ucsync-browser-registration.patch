+
+namespace ucsync {
+
+class UCSyncUI;
+
+class UCSyncUIConfig : public content::DefaultWebUIConfig<UCSyncUI> {
+ public:
+  UCSyncUIConfig()
+      : content::DefaultWebUIConfig<UCSyncUI>(content::kChromeUIScheme,
+                                              chrome::kChromeUIUcsyncHost) {}
+};
+
+// Sirve los ficheros de la extensión embebida bajo `chrome://ucsync`. Las llamadas a
+// `chrome.*` se resuelven contra esa extensión en el navegador; ver
+// `util::CanRendererActOnBehalfOfExtension()` y `SiteInstanceGotProcessAndSite()`.
+class UCSyncUI : public content::WebUIController {
+ public:
+  explicit UCSyncUI(content::WebUI* web_ui);
+
+  UCSyncUI(const UCSyncUI&) = delete;
+  UCSyncUI& operator=(const UCSyncUI&) = delete;
+};
+
