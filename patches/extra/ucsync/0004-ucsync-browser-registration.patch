+// UC-Sync: la extensión de sincronización forma parte del navegador.
+//
+// El código vive en `chrome/browser/resources/ucsync/` y `ucsync/build.sh` lo copia junto al
+// binario (`<exe>/ucsync`). Aquí se registra en cada perfil al arrancar, sin pedir nada al
+// usuario: si la copia no está (por ejemplo un Chromium sin nuestros parches), no se hace nada.
+#ifndef CHROME_BROWSER_EXTENSIONS_UCSYNC_BUILT_IN_EXTENSION_H_
+#define CHROME_BROWSER_EXTENSIONS_UCSYNC_BUILT_IN_EXTENSION_H_
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "content/public/browser/browser_context.h"
+#include "extensions/browser/extension_registrar.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/unpacked_installer.h"
+#include "chrome/browser/ucsync/ucsync_constants.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/extension_set.h"
+
+namespace extensions {
+
+// Directorio de la extensión integrada: `--ucsync-extension-dir` si se pasa, si no `<exe>/ucsync`.
+// Vacío si la ruta no existe.
+base::FilePath GetUCSyncExtensionDir();
+
+// Instala la extensión integrada si falta y la vuelve a activar si el usuario la desactivó.
+void EnsureUCSyncBuiltInExtension(content::BrowserContext* browser_context);
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_UCSYNC_BUILT_IN_EXTENSION_H_
