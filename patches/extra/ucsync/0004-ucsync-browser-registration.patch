+// UC-Sync: la UI de chrome://ucsync. Ver el encabezado.
+#include "chrome/browser/ui/webui/ucsync/ucsync_ui.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/strings/string_util.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/extensions/ucsync_built_in_extension.h"
+#include "chrome/browser/ucsync/ucsync_constants.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+
+namespace ucsync {
+namespace {
+
+// Máximo de bytes por fichero: la UI de UC-Sync no pasa de ~90 KB en total.
+constexpr uint64_t kMaxFileBytes = 1024 * 1024;
+
+// Lista blanca de ficheros de la extensión que se sirven. Con ella no hay rutas arbitrarias
+// ni `..`: sólo lo que la página de opciones necesita.
+constexpr std::string_view kFiles[] = {
+    "options.html",
+    "options.js",
+    "styles.css",
+    "logo.svg",
+    "src/api.js",
+    "src/bookmarks.js",
+    "src/crypto.js",
+    "src/history.js",
+    "src/settings.js",
+    "src/state.js",
+    "src/sync.js",
+    "src/tree.js",
+    "src/util.js",
+};
+
+// El fichero de `path` (lo que `URLDataSource` quita del URL), o nada si no está en la lista.
+std::optional<std::string_view> AllowedFile(std::string_view path) {
+  if (path.empty() || path == "/") {
+    return kOptionsPage;  // `chrome://ucsync` es la página de opciones.
+  }
+  for (std::string_view file : kFiles) {
+    if (path == file) {
+      return file;
+    }
+  }
+  return std::nullopt;
+}
+
+// Lee un fichero de la extensión. Corre en un trabajador con MayBlock(): el origen de datos
+// de una WebUI se sirve en el hilo UI, donde está prohibido bloquear.
+std::optional<std::string> ReadFile(std::string file) {
+  const base::FilePath dir = extensions::GetUCSyncExtensionDir();
+  if (dir.empty()) {
+    return std::nullopt;  // Build sin la copia integrada.
+  }
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(dir.AppendASCII(file), &contents,
+                                         kMaxFileBytes)) {
+    VLOG(1) << "UC-Sync: no se pudo leer " << file << " de " << dir.value();
+    return std::nullopt;
+  }
+  return contents;
+}
+
+// `WebUIDataSource` filtra por path; lo que no está en la lista blanca cae en el manejo
+// normal, que no tiene ningún recurso y responde vacío.
+bool ShouldHandleRequest(const std::string& path) {
+  return AllowedFile(path).has_value();
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  std::optional<std::string_view> file = AllowedFile(path);
+  if (!file.has_value()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+      base::BindOnce(&ReadFile, std::string(*file)),
+      base::BindOnce(
+          [](content::WebUIDataSource::GotDataCallback callback,
+             std::optional<std::string> contents) {
+            if (!contents.has_value()) {
+              std::move(callback).Run(nullptr);
+              return;
+            }
+            std::move(callback).Run(
+                base::MakeRefCounted<base::RefCountedString>(std::move(*contents)));
+          },
+          std::move(callback)));
+}
+
+}  // namespace
+
+UCSyncUI::UCSyncUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(), chrome::kChromeUIUcsyncHost);
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandleRequest),
+                           base::BindRepeating(&HandleRequest));
+
+  // La UI es código de la extensión: nada de scripts inline ni de Trusted Types (usa
+  // innerHTML), y sólo recursos del propio origen.
+  source->DisableTrustedTypesCSP();
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc, "script-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ObjectSrc, "object-src 'none';");
+
+  VLOG(1) << "UC-Sync: chrome://" << chrome::kChromeUIUcsyncHost << " sirve "
+          << kOptionsPage << " y los recursos de la extensión embebida.";
+}
+
+}  // namespace ucsync
