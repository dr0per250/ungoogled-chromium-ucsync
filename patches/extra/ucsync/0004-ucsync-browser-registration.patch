@@ -0,0 +1,103 @@
+// UC-Sync: redirección de chrome://ucsync. Ver el encabezado.
+#include "chrome/browser/ui/webui/ucsync/ucsync_ui.h"
+
+#include <string>
+
+#include "base/memory/ref_counted_memory.h"
+#include "chrome/browser/ucsync/ucsync_constants.h"
+#include "chrome/common/webui_url_constants.h"
+#include "base/logging.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "net/base/net_errors.h"
+#include "extensions/common/extension.h"
+#include "ui/base/page_transition_types.h"
+
+namespace ucsync {
+
+namespace {
+
+// `chrome-extension://<id>/options.html` de la extensión embebida.
+GURL OptionsURL() {
+  return extensions::Extension::GetBaseURLFromExtensionId(
+             std::string(ucsync::kExtensionId))
+      .Resolve(std::string(ucsync::kOptionsPage));
+}
+
+}  // namespace
+
+std::string UCSyncRedirectSource::GetSource() {
+  return chrome::kChromeUIUcsyncHost;
+}
+
+std::string UCSyncRedirectSource::GetMimeType(const GURL& url) {
+  return "text/html";
+}
+
+void UCSyncRedirectSource::StartDataRequest(
+    const GURL& url,
+    const content::WebContents::Getter& wc_getter,
+    GotDataCallback callback) {
+  // Refresco inmediato: si por lo que sea la navegación programática no se ejecutó, la página
+  // misma lleva al destino.
+  const std::string html =
+      "<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\">"
+      "<title>UC-Sync</title><meta http-equiv=\"refresh\" content=\"0;url=" +
+      OptionsURL().spec() + "></head><body></body></html>";
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::move(html)));
+}
+
+void RegisterRedirectDataSource(content::BrowserContext* browser_context) {
+  content::URLDataSource::Add(browser_context,
+                              std::make_unique<UCSyncRedirectSource>());
+}
+
+void UCSyncUIConfig::RegisterURLDataSource(content::BrowserContext* browser_context) {
+  content::URLDataSource::Add(browser_context,
+                              std::make_unique<UCSyncRedirectSource>());
+}
+
+UCSyncUI::UCSyncUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  VLOG(1) << "UC-Sync: controller de chrome://ucsync creado";
+  content::URLDataSource::Add(web_ui->GetWebContents()->GetBrowserContext(),
+                              std::make_unique<UCSyncRedirectSource>());
+}
+
+void UCSyncUI::WebUIPrimaryPageChanged(content::Page& page) {
+  Redirect();
+}
+
+void UCSyncUI::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInMainFrame()) {
+    return;
+  }
+  // Tanto si chrome://ucsync cargó como si se quedó en la página de error, hay que ir a la
+  // extensión: sin recursos propios, la primera navegación puede no comprometerse.
+  if (handle->GetURL().host() == chrome::kChromeUIUcsyncHost ||
+      handle->GetNetErrorCode() != net::OK) {
+    Redirect();
+  }
+}
+
+void UCSyncUI::Redirect() {
+  VLOG(1) << "UC-Sync: redirigiendo chrome://ucsync";
+  content::WebContents* contents = web_ui()->GetWebContents();
+  const GURL target = OptionsURL();
+  if (contents->GetLastCommittedURL() == target ||
+      contents->GetVisibleURL() == target) {
+    return;  // Ya estamos en la extensión.
+  }
+
+  content::NavigationController::LoadURLParams params(target);
+  params.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_AUTO_TOPLEVEL | ui::PAGE_TRANSITION_CHAIN_START |
+      ui::PAGE_TRANSITION_CHAIN_END);
+  params.should_replace_current_entry = true;
+  contents->GetController().LoadURLWithParams(params);
+}
+
+}  // namespace ucsync
