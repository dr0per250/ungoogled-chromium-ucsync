+// UC-Sync: `chrome://ucsync` es un atajo a la página de opciones de la extensión integrada.
+#ifndef CHROME_BROWSER_UI_WEBUI_UCSYNC_UCSYNC_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_UCSYNC_UCSYNC_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class Page;
+}  // namespace content
+
+namespace ucsync {
+
+class UCSyncUI;
+
+// Config para chrome://ucsync.
+// Registra la fuente de datos de chrome://ucsync. Hay que hacerlo antes de navegar: el
+// cargador de chrome:// busca la fuente al empezar la petición, y el controlador WebUI se crea
+// demasiado tarde (al comprometer la respuesta).
+void RegisterRedirectDataSource(content::BrowserContext* browser_context);
+
+class UCSyncUIConfig : public content::DefaultWebUIConfig<UCSyncUI> {
+ public:
+  UCSyncUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, chrome::kChromeUIUcsyncHost) {}
+
+  // content::WebUIConfig: sin fuente de datos registrada, la navegación a chrome://ucsync no
+  // llega a crear el WebUI.
+  void RegisterURLDataSource(content::BrowserContext* browser_context) override;
+};
+
+// Sirve una página que redirige, por si la navegación programática no llegara a tiempo.
+class UCSyncRedirectSource : public content::URLDataSource {
+ public:
+  UCSyncRedirectSource() = default;
+  UCSyncRedirectSource(const UCSyncRedirectSource&) = delete;
+  UCSyncRedirectSource& operator=(const UCSyncRedirectSource&) = delete;
+
+  // content::URLDataSource:
+  std::string GetSource() override;
+  std::string GetMimeType(const GURL& url) override;
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override;
+};
+
+// Redirige al `options.html` de la extensión embebida; no sirve contenido propio.
+class UCSyncUI : public content::WebUIController,
+                 public content::WebContentsObserver {
+ public:
+  explicit UCSyncUI(content::WebUI* web_ui);
+
+  UCSyncUI(const UCSyncUI&) = delete;
+  UCSyncUI& operator=(const UCSyncUI&) = delete;
+
+  // content::WebUIController:
+  void WebUIPrimaryPageChanged(content::Page& page) override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+ private:
+  void Redirect();
+};
+
+}  // namespace ucsync
+
+#endif  // CHROME_BROWSER_UI_WEBUI_UCSYNC_UCSYNC_UI_H_
