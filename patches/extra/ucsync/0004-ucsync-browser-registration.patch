+++ b/chrome/browser/extensions/ucsync_built_in_extension.cc
@@ -0,0 +1,50 @@
+// UC-Sync: registro de la extensión integrada en el navegador. Ver el encabezado.
+#include "chrome/browser/extensions/ucsync_built_in_extension.h"
+
+#include <string>
+
+#include "base/logging.h"
+
+namespace extensions {
+
+base::FilePath GetUCSyncExtensionDir() {
+  const base::CommandLine& command_line = *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch("ucsync-extension-dir")) {
+    const base::FilePath switch_value =
+        command_line.GetSwitchValuePath("ucsync-extension-dir");
+    if (base::PathExists(switch_value.Append("manifest.json"))) {
+      return switch_value;
+    }
+    return base::FilePath();
+  }
+
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return base::FilePath();
+  }
+  const base::FilePath dir = exe_dir.Append("ucsync");
+  return base::PathExists(dir.Append("manifest.json")) ? dir : base::FilePath();
+}
+
+void EnsureUCSyncBuiltInExtension(content::BrowserContext* browser_context) {
+  const base::FilePath dir = GetUCSyncExtensionDir();
+  if (dir.empty()) {
+    return;  // Build sin la copia integrada: no hay UC-Sync que registrar.
+  }
+
+  const std::string id(ucsync::kExtensionId);
+  ExtensionRegistry* registry = ExtensionRegistry::Get(browser_context);
+  if (registry->GetInstalledExtension(id)) {
+    // UC-Sync es parte del navegador: si alguien lo desactivó en chrome://extensions, se
+    // reactiva en cada arranque.
+    if (registry->disabled_extensions().Contains(id)) {
+      ExtensionRegistrar::Get(browser_context)->EnableExtension(id);
+    }
+    return;
+  }
+
+  UnpackedInstaller::Create(browser_context)->Load(dir);
+  VLOG(1) << "UC-Sync: registrada la extensión integrada de " << dir.value();
+}
+
+}  // namespace extensions
