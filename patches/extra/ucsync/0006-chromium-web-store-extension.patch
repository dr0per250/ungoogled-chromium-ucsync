+        chrome.management.uninstall(request.uninstallExt, () => {
+            sendResponse({ uninstalled: !chrome.runtime.lastError });
+        });
+        return true;
+    }
+    if (request.installExt) {
+        tabsAwaitingInstall.add(sender.tab.id);
+    }
