diff --git a/chrome/browser/resources/chromium-web-store/sheets/options.css b/chrome/browser/resources/chromium-web-store/sheets/options.css
new file mode 100644
index 0000000..26c00c6
--- /dev/null
+++ b/chrome/browser/resources/chromium-web-store/sheets/options.css
@@ -0,0 +1,69 @@
+body {
+    margin-bottom: 2rem;
+    width: 500px;
+    font-size: 81.25%;
+}
+
+h2 {
+    line-height: 1.8;
+    border-bottom: 1px solid #dbdbdb;
+    margin-bottom: 1rem;
+    padding-bottom: 0.4rem;
+}
+
+label {
+    display: inline-flex;
+    align-items: center;
+    margin-left: 1rem;
+    line-height: 1.8;
+}
+
+label.sub {
+    margin-left: 2.5rem;
+}
+
+label > span {
+    margin-left: 0.3rem;
+    user-select: none;
+}
+
+label > input {
+    flex: 0 0 auto;
+}
+
+label > img {
+    flex: 0 0 auto;
+    margin: auto 4px auto 8px;
+    width: 16px;
+    height: 16px;
+}
+
+input[type="number"] {
+    width: 3.8rem;
+    line-height: 1rem;
+}
+
+label.disabled {
+    color: grey;
+}
+
+textarea {
+    margin-left: 1rem;
+    width: calc(100% - 2rem);
+    resize: vertical;
+}
+
+#import_export_list {
+    height: 20em;
+}
+
+#import_all_button {
+    margin-left: 1rem;
+}
+
+@media (prefers-color-scheme: dark) {
+body,textarea {
+    background-color: #313131;
+    color: #bfbfbf;
+}
+}
diff --git a/chrome/browser/resources/chromium-web-store/sheets/popup.css b/chrome/browser/resources/chromium-web-store/sheets/popup.css
new file mode 100644
index 0000000..4b9ca2c
--- /dev/null
+++ b/chrome/browser/resources/chromium-web-store/sheets/popup.css
@@ -0,0 +1,166 @@
+#app {
+    font-size: 14px;
+    color: #333;
+    user-select: none;
+}
+
+.message {
+    margin-top: 0;
+    margin-bottom: 0;
+    font-size: 14px;
+    font-weight: normal;
+    text-align: center;
+}
+
+ul {
+    margin-top: 0;
+    margin-bottom: 0;
+    padding-left: 0;
+    list-style-type: none;
+}
+
+.message,
+ul li {
+    margin: 6px 4px;
+    min-height: 32px;
+    border-radius: 2px;
+    box-shadow: 0 0 0 1px #e3e3e3, 0 0 2px 0 rgba(229, 233, 239, 0.3);
+    transition: background-color 0.15s;
+    overflow: hidden;
+}
+
+.message {
+    height:auto;
+    display: flex;
+    align-items: center;
+}
+
+ul li {
+    display: flex;
+    align-items: center;
+    cursor: pointer;
+}
+
+ul li[data-enabled="false"] {
+    background-color: #c2c2c2;
+}
+
+ul li:hover {
+    outline-color: #4d90fe;
+    outline-style: auto;
+    outline-width: 1px;
+}
+
+.message.hidden,
+ul li.hidden {
+    display: none;
+}
+
+img {
+    flex: 0 0 auto;
+    margin: auto 4px auto 8px;
+    width: 16px;
+    height: 16px;
+}
+
+span,
+.message p {
+    flex: 1 1 100%;
+    margin: auto 4px auto 4px;
+}
+
+span {
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    overflow: hidden;
+}
+
+a,
+input {
+    flex: 0 0 auto;
+    margin: auto 8px auto 4px;
+}
+
+li > a {
+    cursor: pointer;
+}
+
+a:hover {
+    color: #e60000;
+}
+
+.updatefailure,
+.updatefailure:hover {
+    background-color: #ffcccb;
+}
+
+.updatefailure[data-enabled="false"] {
+    background-color: #e7b9b8;
+}
+
+#removedStatus {
+    box-shadow: 0 0 0 1px #e60000, 0 0 2px 0 #e60000;
+}
+
+.removedext,
+.removedext:hover,
+.updatefailure,
+.updatefailure:hover {
+    cursor: auto;
+    outline-style: none;
+}
+
+svg {
+    fill: rgb(95, 99, 104);
+    width: 20px;
+    height: 20px;
+}
+
+.removedext svg,
+.updatefailure svg {
+    width: 16px;
+    height: 16px;
+}
+
+a:hover > svg {
+    transform: scale(1.15);
+}
+
+@media (prefers-color-scheme: dark) {
+    body,
+    #app {
+        background-color: #313131;
+        color: #bfbfbf;
+    }
+
+    ul li[data-enabled="false"] {
+        background-color: initial;
+        color: #717171;
+        box-shadow: 0 0 0 1px #6d6d6d, 0 0 2px 0 rgba(89, 111, 144, 0.3);
+    }
+
+    ul li:hover {
+        outline: none;
+        filter: brightness(1.8);
+    }
+
+    ul li:hover img {
+        filter: brightness(.55555);
+    }
+
+    .removedext,
+    .removedext:hover,
+    .updatefailure,
+    .updatefailure:hover,
+    .removedext img,
+    .removedext:hover img,
+    .updatefailure img,
+    .updatefailure:hover img {
+        filter: none;
+    }
+
+    .updatefailure,
+    .updatefailure:hover {
+        color: #313131;
+    }
+}
