+const msgHandler = function (request, sender, sendResponse) {
+    if (request.nonWebstoreDownloadUrl) {
+        chrome.downloads.download(
+            {
+                url: request.nonWebstoreDownloadUrl,
+            },
+            (dlid) => {
+                nonWebstoreExtensionsDownloading.add(dlid);
