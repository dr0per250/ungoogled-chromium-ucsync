+void WebContentsImpl::NotifyTitleUpdateThrottled(NavigationEntryImpl* entry) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (last_title_notify_time_.is_null() ||
+      now - last_title_notify_time_ >= kMinTitleNotifyInterval) {
+    last_title_notify_time_ = now;
+    deferred_title_entry_unique_id_ = -1;
+    NotifyTitleUpdateForEntry(entry);
+    return;
+  }
+
+  // Dentro de la ventana de coalescencia sólo se guarda a qué entrada hay que entregar el
+  // título; se notifica una vez al cerrarla, de forma que el título visible siempre acaba
+  // siendo el último que escribió la página.
+  deferred_title_entry_unique_id_ = entry->GetUniqueID();
+  if (!title_notify_timer_.IsRunning()) {
+    title_notify_timer_.Start(
+        FROM_HERE, kMinTitleNotifyInterval - (now - last_title_notify_time_), this,
+        &WebContentsImpl::FlushDeferredTitleUpdate);
+  }
+}
+
+void WebContentsImpl::FlushDeferredTitleUpdate() {
+  last_title_notify_time_ = base::TimeTicks::Now();
+  if (deferred_title_entry_unique_id_ == -1) {
+    return;
+  }
+  const int unique_id = deferred_title_entry_unique_id_;
+  deferred_title_entry_unique_id_ = -1;
+  NavigationEntryImpl* entry =
+      GetController().GetEntryWithUniqueIDIncludingPending(unique_id);
+  if (entry) {
+    NotifyTitleUpdateForEntry(entry);
+  }
+}
