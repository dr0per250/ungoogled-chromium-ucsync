+void Document::ScheduleTitleSendToBrowser() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (last_title_send_time_.is_null() ||
+      now - last_title_send_time_ >= kMinTitleSendInterval) {
+    SendTitleToBrowser();
+    return;
+  }
+  // Deja pendiente un envio con el ultimo titulo: se coalescen los cambios
+  // rapidos pero el valor final llega siempre al navegador.
+  if (!title_send_pending_) {
+    title_send_pending_ = true;
+    title_send_timer_.StartOneShot(
+        kMinTitleSendInterval - (now - last_title_send_time_), FROM_HERE);
+  }
+}
+
+void Document::TitleSendTimerFired(TimerBase*) {
+  title_send_pending_ = false;
+  if (!IsInMainFrame()) {
+    return;
+  }
+  SendTitleToBrowser();
+}
+
+void Document::SendTitleToBrowser() {
+  last_title_send_time_ = base::TimeTicks::Now();
+  String shortened_title = title_.substr(0, mojom::blink::kMaxTitleChars);
+  GetFrame()->GetLocalFrameHostRemote().UpdateTitle(shortened_title);
+  GetFrame()->GetPage()->GetPageScheduler()->OnTitleOrFaviconUpdated();
+}
